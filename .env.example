BOT_TOKEN=put_your_bot_token_here
# Числовые Telegram ID администраторов через запятую.
ADMIN_TELEGRAM_IDS=
# Числовые Telegram ID мастеров через запятую.
MASTER_TELEGRAM_IDS=
# KodikRouter key with gateway:write scope. OPENAI_API_KEY remains a legacy fallback.
KODIKROUTER_API_KEY=
KODIKROUTER_BASE_URL=https://api.kodikrouter.ru/v1
# Must include the provider prefix and support vision + structured output.
KODIKROUTER_MODEL=openai/gpt-5.4-mini
