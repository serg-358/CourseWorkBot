BOT_TOKEN=put_your_bot_token_here
# Числовые Telegram ID администраторов через запятую.
ADMIN_TELEGRAM_IDS=
# Числовые Telegram ID мастеров через запятую.
MASTER_TELEGRAM_IDS=
# Для локальной работы оставьте DATABASE_URL пустым: используется DATABASE_PATH.
DATABASE_URL=
# Имя бота без @, используется для ссылки из веб-кабинета.
BOT_USERNAME=
# Отдельный случайный секрет веб-сессий (минимум 32 случайных байта).
WEB_SESSION_SECRET=
WEB_COOKIE_SECURE=0
# Для PostgreSQL/веб-развёртывания заполните оба значения и подготовьте пустую БД.
POSTGRES_PASSWORD=
TARGET_DATABASE_URL=
# KodikRouter key with gateway:write scope. OPENAI_API_KEY remains a legacy fallback.
KODIKROUTER_API_KEY=
KODIKROUTER_BASE_URL=https://api.kodikrouter.ru/v1
# Must include the provider prefix and support vision + structured output.
KODIKROUTER_MODEL=openai/gpt-5.4-mini
